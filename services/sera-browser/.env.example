# SERA Browser Agent configuration. Copy to .env and edit.

# Browser mode: auto | headed | headless
SBA_BROWSER_MODE=auto

# Timeouts (ms)
SBA_DEFAULT_TIMEOUT_MS=30000
SBA_NAVIGATION_TIMEOUT_MS=45000
SBA_NETWORK_IDLE_TIMEOUT_MS=8000
SBA_ACTION_TIMEOUT_MS=15000

# Task limits
SBA_MAX_STEPS=40
SBA_MAX_TASK_DURATION_S=300

# Loop detection thresholds
SBA_TOOL_REPEAT_LIMIT=4
SBA_SEMANTIC_LOOP_LIMIT=3

# Security
SBA_LOCAL_LAB=false
SBA_ALLOWED_DOMAINS=
SBA_ALLOWED_PRIVATE_TARGETS=
SBA_ALLOW_JS_EVAL=false
SBA_LOG_SENSITIVE=false

# Optional fallback
SBA_ENABLE_BROWSER_USE_FALLBACK=false

# LLM planner (provider-agnostic)
# none    → deterministic planner only (default; zero LLM dependency)
# zai     → use the `z-ai` CLI as the LLM provider
# openai  → use any OpenAI-compatible REST API (OpenAI, Azure, OpenRouter,
#           Together, Anyscale, vLLM, Ollama, LM Studio, ...)
SBA_LLM_PROVIDER=none
SBA_LLM_MODEL=
SBA_LLM_API_KEY=
SBA_LLM_BASE_URL=
SBA_LLM_TIMEOUT_S=30
SBA_LLM_VISION_CAPABLE=false
SBA_LLM_MAX_CONSECUTIVE_FALLBACKS=5

# Examples:
#   OpenAI:        SBA_LLM_PROVIDER=openai  SBA_LLM_MODEL=gpt-4o-mini
#                  SBA_LLM_API_KEY=sk-...   SBA_LLM_BASE_URL=https://api.openai.com/v1
#   Azure OpenAI:  SBA_LLM_PROVIDER=openai  SBA_LLM_MODEL=my-deployment
#                  SBA_LLM_API_KEY=...      SBA_LLM_BASE_URL=https://my-resource.openai.azure.com/v1
#   OpenRouter:    SBA_LLM_PROVIDER=openai  SBA_LLM_MODEL=anthropic/claude-3.5-sonnet
#                  SBA_LLM_API_KEY=sk-or-... SBA_LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:        SBA_LLM_PROVIDER=openai  SBA_LLM_MODEL=llama3.2
#                  SBA_LLM_BASE_URL=http://127.0.0.1:11434/v1
#   Z.ai CLI:      SBA_LLM_PROVIDER=zai     SBA_LLM_MODEL=glm-4-plus

# Stealth layer (anti-bot fingerprint evasion). off | light | medium | aggressive
SBA_STEALTH_LEVEL=off
# Fixed stealth values (empty = randomized):
SBA_STEALTH_USER_AGENT=
SBA_STEALTH_VIEWPORT=           # "WxH" e.g. "1920x1080"
SBA_STEALTH_TIMEZONE=
SBA_STEALTH_LOCALE=
SBA_STEALTH_PROXY=              # "http://user:pass@host:port"

# Multi-agent pattern: none | plan_act_validate
# plan_act_validate = Skyvern-style Planner/Actor/Validator with Reflexion
SBA_AGENT_PATTERN=none

# Real-view browser viewer (human-takeoverable, for SERA chat UI)
# When enabled, the browser launches in headed mode with CDP remote debugging,
# and the agent streams screenshots + state to WebSocket clients.
# The human can watch every step and grab control at any time.
SBA_ENABLE_VIEWER=false
SBA_VIEWER_CDP_PORT=9222          # CDP remote debugging port
SBA_VIEWER_STREAM_SCREENSHOTS=true
SBA_VIEWER_SCREENSHOT_QUALITY=60  # JPEG quality 1-100
SBA_VIEWER_SCREENSHOT_MAX_WIDTH=1280
SBA_VIEWER_TAKEOVER_TIMEOUT_S=300 # how long the agent waits for the human
SBA_VIEWER_FORCE_HEADED=true      # force headed mode when viewer is enabled

# API
SBA_API_HOST=127.0.0.1
SBA_API_PORT=8765

# Storage
SBA_SESSION_ROOT=/tmp/sera-browser-agent/sessions
SBA_SCREENSHOT_ROOT=/tmp/sera-browser-agent/screenshots

# Logging
SBA_LOG_LEVEL=INFO
SBA_LOG_FORMAT=json
